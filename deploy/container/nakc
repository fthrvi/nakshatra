#!/usr/bin/env bash
set -euo pipefail
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
CONTAINER_NAME="${NAKC_NAME:-nakshatra-node}"
VOLUME_NAME="${NAKC_VOLUME:-nakshatra-node-state}"
CONFIG_DIR="${NAKC_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/nakshatra-container}"
VARIANT="${NAKC_VARIANT:-cpu}"
IMAGE="${NAKC_IMAGE:-nakshatra-node:$VARIANT}"
DRY_RUN="${NAKC_DRY_RUN:-0}"

die() { printf 'nakc: %s\n' "$*" >&2; exit 2; }

engine() {
    if [ -n "${NAKC_ENGINE:-}" ]; then
        command -v "$NAKC_ENGINE" >/dev/null 2>&1 || die "container engine not found: $NAKC_ENGINE"
        printf '%s\n' "$NAKC_ENGINE"
    elif command -v podman >/dev/null 2>&1; then
        printf '%s\n' podman
    elif command -v docker >/dev/null 2>&1; then
        printf '%s\n' docker
    else
        die "install Docker or Podman first"
    fi
}

print_command() {
    local item
    printf '+ '
    for item in "$@"; do printf '%q ' "$item"; done
    printf '\n'
}

run() {
    if [ "$DRY_RUN" = 1 ]; then print_command "$@"; else "$@"; fi
}

config_read() {
    local name="$1"
    [ -f "$CONFIG_DIR/$name" ] && sed -n '1p' "$CONFIG_DIR/$name" || true
}

config_write() {
    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "$2" >"$CONFIG_DIR/$1"
}

container_exists() {
    [ "$DRY_RUN" != 1 ] && "$(engine)" container inspect "$CONTAINER_NAME" >/dev/null 2>&1
}

container_running() {
    [ "$DRY_RUN" != 1 ] && [ "$("$(engine)" inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null || true)" = true ]
}

base_image() {
    case "$VARIANT" in
        cpu) printf '%s\n' 'debian:12.12-slim' ;;
        nvidia) printf '%s\n' 'nvidia/cuda:13.0.1-devel-ubuntu24.04' ;;
        rocm) printf '%s\n' 'rocm/dev-ubuntu-24.04:7.0.2-complete' ;;
        *) die "NAKC_VARIANT must be cpu, nvidia, or rocm" ;;
    esac
}

ensure_image() {
    local runtime="$1"
    if [ "$DRY_RUN" = 1 ]; then return; fi
    if ! "$runtime" image inspect "$IMAGE" >/dev/null 2>&1; then
        "$runtime" build --pull -t "$IMAGE" -f "$SCRIPT_DIR/Containerfile" \
            --build-arg "NAK_VARIANT=$VARIANT" --build-arg "BASE_IMAGE=$(base_image)" "$SCRIPT_DIR"
    fi
}

valid_port() {
    [[ "$1" =~ ^[1-9][0-9]{0,4}$ ]] && [ "$1" -le 65535 ]
}

gateway_port() {
    local port="${NAKC_GATEWAY_PORT:-11600}"
    valid_port "$port" || die "NAKC_GATEWAY_PORT must be a canonical port between 1 and 65535"
    printf '%s\n' "$port"
}

validate_p2p_port() {
    local port="$1" host_gateway_port
    valid_port "$port" || die "NAKC_P2P_PORT must be a canonical port between 1 and 65535"
    host_gateway_port="$(gateway_port)" || return
    [ "$port" != 11599 ] || die "NAKC_P2P_PORT must not collide with container gateway port 11599"
    [ "$port" != "$host_gateway_port" ] || \
        die "NAKC_P2P_PORT must not collide with host gateway port $host_gateway_port"
}

run_args() {
    local runtime="$1" share_path share_mode worker_port gateway_on p2p_port host_gateway_port
    share_path="$(config_read share-path)"
    share_mode="$(config_read share-mode)"
    worker_port="$(config_read worker-port)"
    gateway_on="$(config_read gateway-on)"
    p2p_port="${NAKC_P2P_PORT:-$(config_read p2p-port)}"
    p2p_port="${p2p_port:-4001}"
    validate_p2p_port "$p2p_port" || return
    host_gateway_port="$(gateway_port)" || return
    RUN_ARGS=(run -d --name "$CONTAINER_NAME" --hostname "$CONTAINER_NAME"
        --label io.nakshatra.role=node --restart unless-stopped
        --user 11600:11600 --cap-drop ALL --security-opt no-new-privileges
        --read-only --tmpfs "/tmp:rw,nosuid,nodev,size=${NAKC_TMPFS_SIZE:-2g},mode=1777"
        --pids-limit "${NAKC_PIDS_LIMIT:-512}" --memory "${NAKC_MEMORY:-16g}"
        --network bridge --stop-timeout "${NAKC_STOP_TIMEOUT:-20}"
        --publish "127.0.0.1:$host_gateway_port:11599/tcp"
        --env "NAK_UPDATE_INTERVAL_S=${NAKC_UPDATE_INTERVAL_S:-3600}")
    if [ "${runtime##*/}" = podman ]; then
        RUN_ARGS+=(--volume "$VOLUME_NAME:/state:U")
    else
        RUN_ARGS+=(--volume "$VOLUME_NAME:/state")
    fi
    if [ -n "$share_path" ]; then
        if [ "${share_mode:-ro}" = rw ]; then
            RUN_ARGS+=(--mount "type=bind,src=$share_path,dst=/share")
        else
            RUN_ARGS+=(--mount "type=bind,src=$share_path,dst=/share,readonly")
        fi
    fi
    if [ -n "$worker_port" ]; then
        valid_port "$worker_port" || die "stored worker port must be a canonical port between 1 and 65535"
        RUN_ARGS+=(--env "NAK_CONTAINER_WORKER=1" --env "NAK_CONTAINER_P2P_PORT=$p2p_port"
            --publish "0.0.0.0:$p2p_port:$p2p_port/tcp"
            --publish "0.0.0.0:$p2p_port:$p2p_port/udp")
    elif [ -n "$gateway_on" ]; then
        # With no host IP, Docker/Podman publish on every available IPv4 and IPv6 host
        # address. Keeping host and container ports equal gives libp2p truthful addresses.
        RUN_ARGS+=(--env "NAK_CONTAINER_CONSUMER_P2P_PORT=$p2p_port"
            --publish "$p2p_port:$p2p_port/tcp"
            --publish "$p2p_port:$p2p_port/udp")
    fi
    case "$VARIANT" in
        nvidia)
            if [ "${runtime##*/}" = podman ]; then
                RUN_ARGS+=(--device nvidia.com/gpu=all)
            else
                RUN_ARGS+=(--gpus all)
            fi
            ;;
        rocm) RUN_ARGS+=(--device /dev/kfd --device /dev/dri) ;;
    esac
    RUN_ARGS+=("$IMAGE")
}

start_container() {
    local runtime="$1"
    ensure_image "$runtime" || return
    if container_exists; then run "$runtime" rm -f "$CONTAINER_NAME" >/dev/null || return; fi
    run_args "$runtime" || return
    if [ -n "$(config_read worker-port)" ]; then
        printf 'nakc: deliberate public port: libp2p sidecar 0.0.0.0:%s (tcp+udp); worker gRPC stays on container loopback\n' \
            "${NAKC_P2P_PORT:-$(config_read p2p-port)}" >&2
    elif [ -n "$(config_read gateway-on)" ]; then
        printf 'nakc: deliberate public port: libp2p sidecar 0.0.0.0:%s (tcp+udp) for direct paths; forwards nothing inbound\n' \
            "${NAKC_P2P_PORT:-$(config_read p2p-port)}" >&2
    fi
    run "$runtime" "${RUN_ARGS[@]}"
}

restart_with_stored_p2p_port() {
    local runtime="$1"
    # An attempted NAKC_P2P_PORT override belongs to the failed generation. Recreate the previous
    # generation from its restored config (or the default when it had no persisted P2P port).
    (unset NAKC_P2P_PORT; start_container "$runtime") || true
}

ensure_running() {
    local runtime="$1"
    if ! container_running; then start_container "$runtime"; fi
}

worker_port_from_args() {
    local previous='' item
    for item in "$@"; do
        if [ "$previous" = port ]; then printf '%s\n' "$item"; return; fi
        case "$item" in
            --port) previous=port ;;
            --port=*) printf '%s\n' "${item#--port=}"; return ;;
            *) previous='' ;;
        esac
    done
}

usage() {
    cat <<'EOF'
usage: nakc join '<invite line>'
       nakc start [--share-rw] | stop | status | logs | update
       nakc gateway on|off|status ...
       nakc worker build|on|off|status ...
       nakc share [--share-rw] <directory>
       nakc mcp

Environment: NAKC_ENGINE=docker|podman, NAKC_VARIANT=cpu|nvidia|rocm,
NAKC_MEMORY=16g, NAKC_PIDS_LIMIT=512, NAKC_P2P_PORT=4001, NAKC_DRY_RUN=1.
EOF
}

main() {
    [ "$#" -gt 0 ] || { usage; exit 2; }
    local command="$1" runtime port path mode old_port old_gateway old_p2p_port p2p_port item
    shift
    runtime="$(engine)"
    case "$command" in
        start)
            if [ "${1:-}" = --share-rw ]; then
                [ -n "$(config_read share-path)" ] || die "configure a share first with: nakc share <directory>"
                config_write share-mode rw
                shift
            fi
            [ "$#" -eq 0 ] || die "start takes only the optional --share-rw flag"
            start_container "$runtime"
            ;;
        stop)
            [ "$#" -eq 0 ] || die "stop takes no arguments"
            if container_exists; then run "$runtime" stop "$CONTAINER_NAME"; fi
            ;;
        status)
            [ "$#" -eq 0 ] || die "status takes no arguments"
            run "$runtime" ps -a --filter "name=^${CONTAINER_NAME}$"
            if container_running; then run "$runtime" exec "$CONTAINER_NAME" nak-container-control status; fi
            ;;
        logs)
            run "$runtime" logs "$@" "$CONTAINER_NAME"
            ;;
        update)
            [ "$#" -eq 0 ] || die "update takes no arguments"
            ensure_running "$runtime"
            run "$runtime" exec "$CONTAINER_NAME" nak-container-control update
            ;;
        join)
            [ "$#" -eq 1 ] || die "join needs the single complete invite line"
            ensure_running "$runtime"
            if [ "$DRY_RUN" = 1 ]; then
                printf '+ printf %s\\n %s | ' "%s" "'<invite redacted>'"
                print_command "$runtime" exec -i "$CONTAINER_NAME" nak-container-bootstrap
            else
                printf '%s\n' "$1" | "$runtime" exec -i "$CONTAINER_NAME" nak-container-bootstrap
            fi
            ;;
        share)
            mode=ro
            if [ "${1:-}" = --share-rw ]; then mode=rw; shift; fi
            [ "$#" -eq 1 ] || die "share needs [--share-rw] <directory>"
            [ -d "$1" ] || die "share path is not a directory: $1"
            path="$(cd "$1" && pwd -P)"
            config_write share-path "$path"
            config_write share-mode "$mode"
            printf 'share configured %s at /share (%s)\n' "$path" "$mode"
            if container_running; then start_container "$runtime"; fi
            ;;
        gateway)
            [ "$#" -gt 0 ] || die "gateway needs on, off, or status"
            if [ "$1" = on ]; then
                shift
                for item in "$@"; do
                    case "$item" in
                        --pillar-url|--pillar-url=*|--pillar-spki|--pillar-spki=*|\
                        --package-url|--package-url=*|--package-pubkey|--package-pubkey=*)
                            ;;
                        --b*|--p*|--allow*)
                            die "nakc fixes the gateway bind and port; omit $item"
                            ;;
                    esac
                done
                old_gateway="$(config_read gateway-on)"
                old_p2p_port="$(config_read p2p-port)"
                p2p_port="${NAKC_P2P_PORT:-${old_p2p_port:-4001}}"
                validate_p2p_port "$p2p_port"
                config_write gateway-on 1
                config_write p2p-port "$p2p_port"
                if ! (start_container "$runtime"); then
                    if [ -n "$old_gateway" ]; then
                        config_write gateway-on "$old_gateway"
                    else
                        rm -f "$CONFIG_DIR/gateway-on"
                    fi
                    if [ -n "$old_p2p_port" ]; then
                        config_write p2p-port "$old_p2p_port"
                    else
                        rm -f "$CONFIG_DIR/p2p-port"
                    fi
                    restart_with_stored_p2p_port "$runtime"
                    return 1
                fi
                if ! run "$runtime" exec -i "$CONTAINER_NAME" nak gateway on \
                        --bind 0.0.0.0 --port 11599 --allow-lan "$@"; then
                    if [ -n "$old_gateway" ]; then
                        config_write gateway-on "$old_gateway"
                    else
                        rm -f "$CONFIG_DIR/gateway-on"
                    fi
                    if [ -n "$old_p2p_port" ]; then
                        config_write p2p-port "$old_p2p_port"
                    else
                        rm -f "$CONFIG_DIR/p2p-port"
                    fi
                    restart_with_stored_p2p_port "$runtime"
                    return 1
                fi
            elif [ "$1" = off ]; then
                old_gateway="$(config_read gateway-on)"
                ensure_running "$runtime"
                run "$runtime" exec -i "$CONTAINER_NAME" nak gateway "$@"
                rm -f "$CONFIG_DIR/gateway-on"
                if [ -n "$old_gateway" ] && [ -z "$(config_read worker-port)" ] && [ "$DRY_RUN" != 1 ]; then
                    start_container "$runtime"
                fi
            else
                ensure_running "$runtime"
                run "$runtime" exec -i "$CONTAINER_NAME" nak gateway "$@"
            fi
            ;;
        worker)
            [ "$#" -gt 0 ] || die "worker needs build, on, off, or status"
            if [ "$1" = on ]; then
                old_port="$(config_read worker-port)"
                old_p2p_port="$(config_read p2p-port)"
                port="$(worker_port_from_args "$@")"
                port="${port:-$old_port}"
                [ -n "$port" ] || die "worker on needs --port on its first configuration"
                valid_port "$port" || die "worker --port must be a canonical port between 1 and 65535"
                p2p_port="${NAKC_P2P_PORT:-${old_p2p_port:-4001}}"
                validate_p2p_port "$p2p_port"
                config_write worker-port "$port"
                config_write p2p-port "$p2p_port"
                if ! (start_container "$runtime"); then
                    if [ -n "$old_port" ]; then
                        config_write worker-port "$old_port"
                    else
                        rm -f "$CONFIG_DIR/worker-port"
                    fi
                    if [ -n "$old_p2p_port" ]; then
                        config_write p2p-port "$old_p2p_port"
                    else
                        rm -f "$CONFIG_DIR/p2p-port"
                    fi
                    restart_with_stored_p2p_port "$runtime"
                    return 1
                fi
                if [ "$DRY_RUN" = 1 ]; then
                    run "$runtime" exec -i "$CONTAINER_NAME" nak p2p on
                    run "$runtime" exec -i "$CONTAINER_NAME" nak worker "$@"
                elif ! "$runtime" exec -i "$CONTAINER_NAME" nak p2p on || \
                     ! "$runtime" exec -i "$CONTAINER_NAME" nak worker "$@"; then
                    if [ -n "$old_port" ]; then
                        config_write worker-port "$old_port"
                    else
                        rm -f "$CONFIG_DIR/worker-port"
                    fi
                    if [ -n "$old_p2p_port" ]; then
                        config_write p2p-port "$old_p2p_port"
                    else
                        rm -f "$CONFIG_DIR/p2p-port"
                    fi
                    restart_with_stored_p2p_port "$runtime"
                    return 1
                fi
            else
                ensure_running "$runtime"
                run "$runtime" exec -i "$CONTAINER_NAME" nak worker "$@"
            fi
            if [ "$1" = off ] && [ "$DRY_RUN" != 1 ]; then
                rm -f "$CONFIG_DIR/worker-port"
                start_container "$runtime"
            fi
            ;;
        mcp)
            [ "$#" -eq 0 ] || die "mcp takes no arguments"
            if [ "$DRY_RUN" = 1 ]; then
                print_command "$runtime" exec -i "$CONTAINER_NAME" nak-mcp
            else
                exec "$runtime" exec -i "$CONTAINER_NAME" nak-mcp
            fi
            ;;
        -h|--help|help) usage ;;
        *) die "unknown command: $command" ;;
    esac
}

main "$@"
