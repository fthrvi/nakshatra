# Copy the values created by the worker. Keep this file private.
OWNER_LEASE_PORT=5571
OWNER_LEASE_TOKEN=replace-with-the-worker-generated-token
# Windows launcher: the WSL distro and Linux account that own the signed release tree.
OWNER_WSL_DISTRO=Ubuntu
OWNER_WSL_USER=replace-with-linux-username
OWNER_GPU_MEMORY_THRESHOLD_MIB=1024
OWNER_AMD_BUSY_THRESHOLD_PERCENT=30
# Windows: process names (-like patterns) whose GPU memory is never the owner's demand.
OWNER_GPU_IGNORE=vmwp,vmmem*,wsl*,dwm,csrss
