# Nakshatra meshd per-node config → install to ~/.nakshatra/meshd.env
# Every var must be defined (systemd drops unset ${TOKENS} from ExecStart).

# Which mesh this node belongs to (sticky identity of the swarm).
MESH_ID=prithvi-q8

# Model id this node serves now (single value; repeat the unit for more).
SERVING=prithvi-q8

# Drift-class fingerprint for the served model — peers MUST match to chain.
# Get it from the gauge:  python scripts/discovery/drift_gauge.py <full-model.gguf>
# Leave as "unset" only on a consumer-only node that serves nothing.
DRIFT_CLASS=rocm-gfx1201-unset

# This node's local gRPC worker (host:port) to expose to peers.
# EMPTY string  → consumer-only node (orchestrator/client; reaches peers' workers).
WORKER_ADDR=

# Advisory dial hint published in the listing (optional; transport still pins).
ENDPOINT_HINT=

# Publish/discover cadence (seconds).
REFRESH=30

# Discovery transport. EMPTY = FileRelay (local/shared dir; the default, and the
# only mode whose filesystem ACL gates admission). Set to a ws(s):// URL to
# publish/discover over a public Nostr relay (needs coincurve + websocket-client).
NOSTR_RELAY=

# Auto-tunnel allowlist — REQUIRED to serve/consume over a public NOSTR_RELAY.
# Path to a file of Ed25519 mesh-pubkey hexes (one per line, # comments). Over a
# public relay, meshd auto-tunnels ONLY to these peers; empty ⇒ observe-only
# (peers are discovered, no tunnel opens). Ignored on FileRelay. Get a peer's
# pubkey from its mesh-status.json ("pubkey"). Leave empty until you deliberately
# open this node to the public network.
PEER_ALLOWLIST=

# Optional: override routing listing-freshness (seconds; consumed by the serve
# proxy, not meshd). Default 120. Set at/above meshd's effective TTL
# (max(90, 4×REFRESH)) so a peer meshd still holds live isn't 404'd by the proxy.
# 0 disables the gate. Export in the SERVE unit's environment, not here.
# NKS_ROUTE_MAX_AGE_S=120
