{
 "name": "nakshatra-node",
 "python": "3.12",
 "installer": "nakshatra/release/install.py",
 "components": [
  {
   "name": "nakshatra",
   "repo": "~/nakshatra",
   "paths": [
    "scripts",
    "proto",
    "release",
    "engine",
    "third_party/shard-libp2p-sidecar",
    "deploy/provision-worker.sh",
    "deploy/owner-sentinel"
   ],
   "pythonpath": "scripts"
  },
  {
   "name": "sthambha",
   "repo": "~/sthambha",
   "paths": [
    "sthambha",
    "pyproject.toml"
   ],
   "pythonpath": "."
  }
 ],
 "binaries": [
  {
   "name": "nakshatra-sidecar",
   "file": "nakshatra-sidecar",
   "install_path": "bin/nakshatra-sidecar",
   "component": "nakshatra",
   "source": "third_party/shard-libp2p-sidecar"
  }
 ],
 "requirements": [
  "cryptography==46.0.6",
  "coincurve==21.0.0"
 ],
 "services": {
  "nak-signer": {
   "description": "Nakshatra personal signer (Sthambha)",
   "exec": [
    "{python}",
    "-m",
    "sthambha.signer",
    "serve",
    "--state",
    "{home}/.sthambha/signer"
   ],
   "requires": "{home}/.sthambha/signer/person.pub",
   "components": [
    "sthambha"
   ]
  },
  "nak-net": {
   "description": "Nakshatra messaging node (nakd): contacts + messages",
   "exec": [
    "{python}",
    "-m",
    "network.nakd",
    "--state",
    "{home}/.nakshatra/net"
   ],
   "requires": "{home}/.nakshatra/net/agent",
   "components": [
    "nakshatra",
    "sthambha"
   ]
  },
  "nakshatra-relay": {
   "description": "Nakshatra rendezvous relay (untrusted byte-forwarder)",
   "requires": "{home}/.nakshatra/relay.env",
   "env_file": "{home}/.nakshatra/relay.env",
   "environment": {
    "NKS_RELAY_HOST": "::",
    "NKS_RELAY_PORT": "51820"
   },
   "exec": [
    "{python}",
    "{prefix}/current/nakshatra/scripts/transport/relay.py",
    "--host",
    "${NKS_RELAY_HOST}",
    "--port",
    "${NKS_RELAY_PORT}"
   ],
   "restart": "always",
   "hardening": true,
   "components": [
    "nakshatra"
   ]
  },
  "nakshatra-meshd": {
   "description": "Nakshatra node daemon (publish + discover + auto-tunnel)",
   "requires": "{home}/.nakshatra/meshd.env",
   "env_file": "{home}/.nakshatra/meshd.env",
   "after": [
    "network-online.target",
    "nakshatra-relay.service"
   ],
   "environment": {
    "RELAY_DIR": "{home}/.nakshatra/relay",
    "RENDEZVOUS": "45.63.109.137:51820",
    "REFRESH": "30"
   },
   "exec": [
    "{python}",
    "{prefix}/current/nakshatra/scripts/mesh/meshd.py",
    "--mesh-id=${MESH_ID}",
    "--serving=${SERVING}",
    "--relay-dir=${RELAY_DIR}",
    "--rendezvous=${RENDEZVOUS}",
    "--drift-class=${DRIFT_CLASS}",
    "--worker-addr=${WORKER_ADDR}",
    "--endpoint=${ENDPOINT_HINT}",
    "--refresh=${REFRESH}"
   ],
   "restart": "always",
   "hardening": true,
   "components": [
    "nakshatra"
   ]
  },
  "nakshatra-p2p": {
   "description": "Nakshatra libp2p direct-path sidecar (DCUtR hole punching)",
   "requires": "{home}/.nakshatra/p2p.env",
   "env_file": "{home}/.nakshatra/p2p.env",
   "optional_env_files": [
    "{home}/.nakshatra/worker.env"
   ],
   "after": [
    "network-online.target",
    "nak-net.service"
   ],
   "environment": {
    "NAK_DIRECT_PORT": "51830"
   },
   "exec_start_pre": [
    [
     "{python}",
     "{prefix}/current/nakshatra/scripts/sidecar_key.py",
     "--node-key",
     "{home}/.nakshatra/keys/worker.ed25519",
     "--out",
     "{home}/.config/nakshatra-sidecar/node.key",
     "--if-missing"
    ]
   ],
   "exec": [
    "{prefix}/current/nakshatra/bin/nakshatra-sidecar",
    "-key",
    "{home}/.config/nakshatra-sidecar/node.key",
    "-listen",
    "/ip4/0.0.0.0/tcp/0",
    "-quic",
    "-nakd-inbound=127.0.0.1:${NAK_DIRECT_PORT}",
    "-dial-listen=${XDG_RUNTIME_DIR}/nakshatra/p2p.sock",
    "-relays=${P2P_RELAYS}",
    "$NAKSHATRA_P2P_WORKER_ARGS"
   ],
   "restart": "always",
   "hardening": true,
   "read_write_paths": [
    "{home}/.nakshatra",
    "{home}/.config"
   ],
   "components": [
    "nakshatra"
   ],
   "runtime_directory": "nakshatra"
  },
  "nakshatra-registrar": {
   "description": "Nakshatra signed capacity registrar",
   "requires": "{home}/.nakshatra/registrar.env",
   "env_file": "{home}/.nakshatra/registrar.env",
   "after": [
    "network-online.target"
   ],
   "exec": [
    "{python}",
    "{prefix}/current/nakshatra/scripts/registrar.py"
   ],
   "restart": "always",
   "hardening": true,
   "components": [
    "nakshatra"
   ]
  },
  "nakshatra-unconscious": {
   "description": "Nakshatra inference gateway (OpenAI /v1/chat/completions over the mesh)",
   "requires": "{home}/.nakshatra/unconscious.release",
   "env_file": "{home}/.nakshatra/unconscious.env",
   "environment": {
    "PORT": "11599",
    "BIND": "127.0.0.1",
    "MODELS": "{home}/.nakshatra/serve_models.unconscious.yaml"
   },
   "exec": [
    "{python}",
    "{prefix}/current/nakshatra/scripts/nakshatra_serve.py",
    "--port",
    "${PORT}",
    "--bind",
    "${BIND}",
    "--models",
    "${MODELS}"
   ],
   "restart": "always",
   "components": [
    "nakshatra"
   ],
   "drain": {
    "port": 11599,
    "max_wait_s": 900
   }
  },
  "nakshatra-worker": {
   "description": "Nakshatra distributed-inference worker",
   "requires": "{home}/.nakshatra/worker.env",
   "env_file": "{home}/.nakshatra/worker.env",
   "optional_env_files": [
    "{home}/.nakshatra/owner-lease.env"
   ],
   "after": [
    "network-online.target"
   ],
   "environment": {
    "NAKSHATRA_AUDIT_PATH": "{home}/.nakshatra/worker/audit.jsonl",
    "NAKSHATRA_RELEASE_SERVICE": "true"
   },
   "exec": [
    "{python}",
    "{prefix}/current/nakshatra/scripts/worker_service.py",
    "--build-json={home}/.nakshatra/worker/build.json",
    "--engine-base={prefix}/current/nakshatra/engine/BASE",
    "--worker-root={home}/.nakshatra/worker",
    "--worker-script={prefix}/current/nakshatra/scripts/worker.py",
    "--node-key={home}/.nakshatra/keys/worker.ed25519",
    "--p2p-opt-in={home}/.nakshatra/p2p.env",
    "--port=${PORT}",
    "--sub-gguf=${SUB_GGUF}",
    "--mode=${MODE}",
    "--layer-start=${LAYER_START}",
    "--layer-end=${LAYER_END}",
    "--model-id=${MODEL_ID}"
   ],
   "restart": "on-failure",
   "hardening": true,
   "read_write_paths": [
    "{home}/.nakshatra/worker",
    "{home}/.nakshatra/tls"
   ],
   "components": [
    "nakshatra"
   ],
   "profile": "worker"
  }
 },
 "health": [
  [
   "{python}",
   "-c",
   "import sthambha.signer, joincode, transport.secure_channel, transport.mux_tunnel, mesh.meshd, network.nakd, mesh.meshd, transport.relay"
  ]
 ],
 "commands": {
  "nak": "network.nak",
  "nak-mcp": "network.nak_mcp"
 },
 "profiles": {
  "worker": {
   "description": "distributed inference worker (gRPC, protobuf, numpy, GGUF); opt in with ~/.nakshatra/worker.env",
   "requires": "{home}/.nakshatra/worker.env",
   "requirements": [
    "grpcio==1.81.1",
    "protobuf==6.33.6",
    "numpy==1.26.4",
    "gguf==0.19.0"
   ],
   "satisfied_by": [
    "inference"
   ]
  },
  "inference": {
   "description": "inference gateway + chain client (gRPC, numpy, tokenizer); opt in with ~/.nakshatra/inference.env",
   "requires": "{home}/.nakshatra/inference.env",
   "requirements": [
    "grpcio==1.81.1",
    "protobuf==6.33.6",
    "numpy==1.26.4",
    "PyYAML==6.0.3",
    "gguf==0.19.0",
    "llama_cpp_python==0.3.28",
    "requests==2.34.2",
    "websocket-client==1.9.0",
    "diskcache==5.6.3"
   ]
  }
 }
}
